# Conexión con pooling de Neon (la usa la API). En Neon: Connection string > "Pooled connection".
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Conexión directa de Neon (la usa drizzle-kit para migrar). Desactiva "Pooled connection".
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cadena larga y aleatoria. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="cambia-esto"
JWT_EXPIRA="7d"
PORT=3000

# Cloudinary: Dashboard > API Keys > "API environment variable". Si se deja vacío, las fotos se guardan en uploads/.
CLOUDINARY_URL=""
# URL pública de la API (para armar enlaces de fotos locales)
URL_PUBLICA="http://localhost:3000"
CORS_ORIGEN="*"

# IA con Google Gemini (gratis): crea la clave en https://aistudio.google.com/apikey
# Si se deja vacío, el asistente funciona con respuestas locales más simples.
GEMINI_API_KEY=""
GEMINI_MODELO="gemini-3.6-flash"
