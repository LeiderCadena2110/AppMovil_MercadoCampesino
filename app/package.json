{
  "name": "minga-app",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "android": "ng build --configuration development && npx cap sync android && npx cap open android",
    "sincronizar": "ng build --configuration development && npx cap sync android",
    "android:prod": "ng build && npx cap sync android",
    "iconos": "capacitor-assets generate --android --iconBackgroundColor '#1f4d2b' --splashBackgroundColor '#1f4d2b'"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@ionic/angular": "^9.0.7",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
